# Required: your Crustdata API key (https://docs.crustdata.com)
CRUSTDATA_API_KEY=

# Your open jobs (see examples/jobs.example.json)
JOBS_FILE=examples/jobs.example.json
SENDER_NAME=

NEWS_DAYS=7
SINCE_DAYS=60

# Optional: Slack incoming webhook (leave empty to skip)
SLACK_WEBHOOK_URL=

# Optional: Claude step (pip install -r requirements-optional.txt)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
